# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend Proxy URL (Server-side Next.js rewrite target; not exposed to browser)
# In local development: http://localhost:4000
# In production (e.g. Vercel -> Render): https://your-backend.onrender.com
BACKEND_PROXY_URL=http://localhost:4000

# Optional Browser Override (defaults to same-origin relative '/api/*' in browser)
# NEXT_PUBLIC_BACKEND_URL=
