# ==============================================================================
# LeadSync — Environment Configuration Reference
# ==============================================================================

# --- Backend Configuration (.env in /backend) ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Single-Owner Pinning (Only this account can access CRM data or mutate records)
OWNER_GOOGLE_EMAIL=your-owner-email@gmail.com
OWNER_GOOGLE_SUB=

# Cryptographic Session Secret
SESSION_SECRET=your-secure-random-session-secret-at-least-32-chars

# PostgreSQL Database (Neon / Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend Configuration (.env.local in /frontend) ---
BACKEND_PROXY_URL=http://localhost:4000
