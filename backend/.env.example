# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server & Environment
PORT=4000
NODE_ENV=development

# Frontend Application Origin (CORS & OAuth redirection)
APP_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 / OpenID Connect Single-Owner Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Single-Owner Identity Pinning
# OWNER_GOOGLE_EMAIL is mandatory — only this account can authenticate as owner
OWNER_GOOGLE_EMAIL=your-owner-email@gmail.com
# OWNER_GOOGLE_SUB is optional during initial setup, but recommended for immutable subject pinning
OWNER_GOOGLE_SUB=

# Session Secret (min 32 chars in production)
SESSION_SECRET=replace-with-a-secure-random-session-secret-at-least-32-chars
# Legacy secret aliases (optional)
# AUTH_SECRET=
# JWT_SECRET=

# Database (PostgreSQL via Neon, Supabase, or self-hosted)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# AI Batching Config
BATCH_SIZE=20
BATCH_CONCURRENCY=3
BATCH_MAX_RETRIES=3

# Staged Import Retention (TTL in hours)
PENDING_IMPORT_TTL_HOURS=24
