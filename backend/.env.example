# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Neon or Supabase)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# AI Batching Config
BATCH_SIZE=20
BATCH_CONCURRENCY=3
BATCH_MAX_RETRIES=3

# CORS
FRONTEND_URL="http://localhost:3000"

# Authentication & RBAC
# Secure secret for HMAC-SHA256 token verification (min 32 chars in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
# Optional API Key for service-to-service or machine authentication
# API_KEY="your-api-key-here"
# Set to 'true' only in local development to allow unauthenticated requests with a default dev reviewer identity
ALLOW_DEV_ANONYMOUS="false"

# Staged Import Retention
# Pending import staged record TTL in hours (default: 24 hours)
PENDING_IMPORT_TTL_HOURS=24

