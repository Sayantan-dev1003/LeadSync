// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PendingImportStatus {
  PENDING
  APPROVED
  COMMITTED
  REJECTED
  EXPIRED
}

model Import {
  id            String         @id @default(cuid())
  userId        String?
  filename      String
  totalRows     Int
  totalImported Int
  totalSkipped  Int
  createdAt     DateTime       @default(now())
  aiUsage       Json?
  leads         Lead[]
  skippedRows   SkippedRow[]
  pendingImport PendingImport?

  @@index([userId])
  @@map("imports")
}

model Lead {
  id                       String   @id @default(cuid())
  importId                 String
  import                   Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  createdAt                DateTime?
  name                     String?
  email                    String?
  countryCode              String?
  mobileWithoutCountryCode String?
  company                  String?
  city                     String?
  state                    String?
  country                  String?
  leadOwner                String?
  crmStatus                String?
  crmNote                  String?
  dataSource               String?
  possessionTime           String?
  description              String?
  importedAt               DateTime @default(now())

  @@index([importId])
  @@index([email])
  @@map("leads")
}

model SkippedRow {
  id       String @id @default(cuid())
  importId String
  import   Import @relation(fields: [importId], references: [id], onDelete: Cascade)
  rawRow   Json
  reason   String

  @@index([importId])
  @@map("skipped_rows")
}

model PendingImport {
  id                String              @id @default(cuid())
  userId            String?
  filename          String
  totalRows         Int
  status            PendingImportStatus @default(PENDING)
  records           Json
  skipped           Json
  failed            Json
  aiUsage           Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  expiresAt         DateTime
  committedImportId String?             @unique
  committedImport   Import?             @relation(fields: [committedImportId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@index([userId])
  @@map("pending_imports")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  googleSub    String
  email        String
  name         String?
  picture      String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  nonce        String
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([state])
  @@index([expiresAt])
  @@map("oauth_states")
}
